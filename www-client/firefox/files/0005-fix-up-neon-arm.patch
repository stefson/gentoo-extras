@@ -177,10 +177,22 @@ static MOZ_ALWAYS_INLINE xsimd::batch<ui
   return px;
 }
 
+// SwizzleVector_SIMD becomes an overload set once an architecture header
+// specializes it, and GCC cannot resolve the address of an overload set through
+// the more-constrained tie-break. Calling it from a lambda instead defers to
+// ordinary overload resolution, which GCC does handle. Both callers below must
+// share this one wrapper so that they keep sharing Process*_SIMD
+// instantiations.
+template <class Arch, bool aSwapRB, bool aOpaqueAlpha>
+static constexpr auto SwizzleVectorOp_SIMD =
+    [](const xsimd::batch<uint8_t, Arch>& aPx) {
+      return SwizzleVector_SIMD<Arch, aSwapRB, aOpaqueAlpha>(aPx);
+    };
+
 template <class Arch, bool aSwapRB, bool aOpaqueAlpha>
 static MOZ_ALWAYS_INLINE void SwizzleRow_SIMD(const uint8_t* aSrc,
                                               uint8_t* aDst, int32_t aLength) {
-  ProcessRow_SIMD<Arch, SwizzleVector_SIMD<Arch, aSwapRB, aOpaqueAlpha>,
+  ProcessRow_SIMD<Arch, SwizzleVectorOp_SIMD<Arch, aSwapRB, aOpaqueAlpha>,
                   /* Unroll */ true>(aSrc, aDst, aLength);
 }
 
@@ -188,7 +200,7 @@ template <class Arch, bool aSwapRB, bool
 static MOZ_ALWAYS_INLINE void Swizzle_SIMD(const uint8_t* aSrc, int32_t aSrcGap,
                                            uint8_t* aDst, int32_t aDstGap,
                                            IntSize aSize) {
-  Process_SIMD<Arch, SwizzleVector_SIMD<Arch, aSwapRB, aOpaqueAlpha>,
+  Process_SIMD<Arch, SwizzleVectorOp_SIMD<Arch, aSwapRB, aOpaqueAlpha>,
                /* Unroll */ true>(aSrc, aSrcGap, aDst, aDstGap, aSize);
 }
 

